{
  "name": "simya-archive",
  "version": "0.1.0",
  "description": "심야 archive — 공포 콘텐츠 커뮤니티 MVP",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "seed:movies": "node --env-file-if-exists=.env scripts/seed-movies.js",
    "seed:posts": "node --env-file-if-exists=.env scripts/seed-posts.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^14.5.1",
    "sanitize-html": "^2.18.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
